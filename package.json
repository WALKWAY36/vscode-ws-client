{
  "name": "vscode-ws-client",
  "displayName": "WebSocket Test Client",
  "description": "WebSocket client for testing connections",
  "version": "1.1.1",
  "publisher": "walkway36",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Debuggers",
    "Testing"
  ],
  "keywords": [
    "websocket",
    "ws",
    "client",
    "debug",
    "test",
    "socket",
    "realtime"
  ],
  "icon": "src/media/icon.png",
  "galleryBanner": {
    "color": "#C80000",
    "theme": "dark"
  },
  "license": "MIT",
  "homepage": "https://github.com/WALKWAY36/vscode-ws-client",
  "repository": {
    "type": "git",
    "url": "https://github.com/WALKWAY36/vscode-ws-client.git"
  },
  "bugs": {
    "url": "https://github.com/WALKWAY36/vscode-ws-client/issues"
  },
  "activationEvents": [
    "onCommand:ws-client.open"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ws-client-sidebar",
          "title": "WS Client",
          "icon": "$(radio-tower)"
        }
      ]
    },
    "views": {
      "ws-client-sidebar": [
        {
          "type": "webview",
          "id": "ws-client.webview",
          "name": "Client",
          "icon": "$(radio-tower)",
          "contextualTitle": "WebSocket Test Client"
        },
        {
          "id": "ws-client.collections",
          "name": "Collections",
          "icon": "$(folder-library)",
          "contextualTitle": "WS Collections"
        }
      ]
    },
    "commands": [
      {
        "command": "ws-client.open",
        "title": "Open WebSocket Test Client",
        "category": "WS Client"
      },
      {
        "command": "ws-client.collections.new",
        "title": "New Collection",
        "category": "WS Client",
        "icon": "$(add)"
      },
      {
        "command": "ws-client.collections.refresh",
        "title": "Refresh  Collections",
        "category": "WS Client",
        "icon": "$(refresh)"
      },
      {
        "command": "ws-client.collections.rename",
        "title": "Rename Collection",
        "category": "WS Client"
      },
      {
        "command": "ws-client.collections.delete",
        "title": "Delete Collection",
        "category": "WS Client"
      },
      {
        "command": "ws-client.collections.saveRequest",
        "title": "Save Current Request",
        "category": "WS Client"
      },
      {
        "command": "ws-client.collections.loadRequest",
        "title": "Load Request",
        "category": "WS Client",
        "icon": "$(arrow-right)"
      },
      {
        "command": "ws-client.collections.editRequest",
        "title": "Edit Request",
        "category": "WS Client"
      },
      {
        "command": "ws-client.collections.duplicateRequest",
        "title": "Duplicate Request",
        "category": "WS Client"
      },
      {
        "command": "ws-client.collections.deleteRequest",
        "title": "Delete Request",
        "category": "WS Client"
      },

      {
        "command": "ws-client.collections.openTests",
        "title": "Edit Test Cases",
        "category": "WS Client",
        "icon": "$(beaker)"
      },
      {
        "command": "ws-client.collections.runTests",
        "title": "Run Tests",
        "category": "WS Client",
        "icon": "$(play)"
      },
      {
        "command": "ws-client.collections.toggleTestCase",
        "title": "Enable / Disable",
        "category": "WS Client"
      },
      {
        "command": "ws-client.collections.deleteTestCase",
        "title": "Delete Test Case",
        "category": "WS Client"
      }
    ],
    "keybindings": [
      {
        "command": "ws-client.open",
        "key": "ctrl+shift+w",
        "mac": "cmd+shift+w"
      }
    ],
    "configuration": {
      "title": "WebSocket Test Client",
      "properties": {
        "wsClient.urlHistory": {
          "type": "array",
          "default": [],
          "description": "History of WebSocket URLs"
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "ws-client.collections.new",
          "when": "view == ws-client.collections",
          "group": "navigation@1"
        },
        {
          "command": "ws-client.collections.refresh",
          "when": "view == ws-client.collections",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "ws-client.collections.openTests",
          "when": "view == ws-client.collections && viewItem == collection",
          "group": "1_tests@1"
        },
        {
          "command": "ws-client.collections.runTests",
          "when": "view == ws-client.collections && viewItem == collection",
          "group": "1_tests@2"
        },
        {
          "command": "ws-client.collections.rename",
          "when": "view == ws-client.collections && viewItem == collection",
          "group": "2_modify@1"
        },
        {
          "command": "ws-client.collections.delete",
          "when": "view == ws-client.collections && viewItem == collection",
          "group": "3_delete@1"
        },

        {
          "command": "ws-client.collections.loadRequest",
          "when": "view == ws-client.collections && viewItem == savedRequest",
          "group": "1_run@1"
        },
        {
          "command": "ws-client.collections.editRequest",
          "when": "view == ws-client.collections && viewItem == savedRequest",
          "group": "2_modify@1"
        },
        {
          "command": "ws-client.collections.duplicateRequest",
          "when": "view == ws-client.collections && viewItem == savedRequest",
          "group": "2_modify@2"
        },
        {
          "command": "ws-client.collections.deleteRequest",
          "when": "view == ws-client.collections && viewItem == savedRequest",
          "group": "3_delete@1"
        },

        {
          "command": "ws-client.collections.openTests",
          "when": "view == ws-client.collections && viewItem == testSuite",
          "group": "1_run@1"
        },
        {
          "command": "ws-client.collections.runTests",
          "when": "view == ws-client.collections && viewItem == testSuite",
          "group": "1_run@2"
        },
        {
          "command": "ws-client.collections.toggleTestCase",
          "when": "view == ws-client.collections && viewItem == testCase",
          "group": "1_modify@1"
        },
        {
          "command": "ws-client.collections.deleteTestCase",
          "when": "view == ws-client.collections && viewItem == testCase",
          "group": "2_delete@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.5.10",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "ws": "^8.16.0"
  },
  "files": [
    "out/**/*",
    "src/media/**/*",
    "!**/.DS_Store"
  ]
}